 -- Toggle สำหรับสุ่มแร่แบบอัตโนมัติ
Tabs.ButtonTab:Toggle({
    Title = "Auto Random Ore",
    Desc = "เปิด/ปิดการสุ่มแร่",
    Default = false,
    Callback = function(state)
        autorandomore = state
        if autorandomore then
            task.spawn(function()
                while autorandomore do
                    game:GetService("ReplicatedStorage").Packages.Knit.Services.OreService.RE.RequestRandomOre:FireServer()
                    task.wait(0.5) -- ปรับความถี่ได้ตามต้องการ
                end
            end)
        end
    end
})
